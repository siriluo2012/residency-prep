{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w apps/web",
  "outputDirectory": "apps/web/.next",
  "regions": ["iad1"],
  "crons": [
    { "path": "/api/cron/requeue-reported", "schedule": "0 6 * * *" }
  ]
}
