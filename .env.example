# =============================================================================
# Required for a local site
# =============================================================================
# Any Postgres 16+ URL. docker compose and scripts/dev-local.sh use this one:
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/postgres
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local login without Supabase (never set in production).
# Seed creates these two profiles; the login page can also set a cookie.
RP_DEV_USER_ID=00000000-0000-4000-8000-000000000001
RP_DEV_USER_EMAIL=physician@localhost

# =============================================================================
# Optional: Supabase (hosted accounts + hosted Postgres)
# =============================================================================
# Only needed if you want email/Google login for other people. Local study
# works with RP_DEV_USER_ID or the "Continue locally" button instead.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Optional: Anthropic (Claude)
# =============================================================================
# NOT required to run the site. Used only to draft new questions, flashcards,
# animations, OET tasks, and to LLM-grade OET letters. Without a key:
#   - QBank, flashcards, guides, animations, review UI all work
#   - `rp generate flashcards --mode heuristic` derives cards from stems
#   - `rp animate reference` / `rp oet reference` stage hand-authored items
#   - OET writing uses a rule-based practice grader
# ANTHROPIC_API_KEY=
# RP_CLAUDE_MODEL=claude-sonnet-4-5
# RP_CLAUDE_FAST_MODEL=claude-haiku-4-5

# Pipeline
RP_SINK=file
RP_DATA_DIR=./data
RP_EMBED_BACKEND=hash
# VOYAGE_API_KEY=

# Optional telemetry (off when empty)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
